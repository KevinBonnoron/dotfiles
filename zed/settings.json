// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6.1-terra"
      },
      "type": "registry"
    },
    "opencode-v2": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry"
    }
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "agent": {
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "thinking_display": "always_collapsed",
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "icon_theme": {
    "mode": "light",
    "light": "VSCode Icons for Zed (Dark)",
    "dark": "VSCode Icons for Zed (Dark)"
  },
  "project_panel": {
    "hide_root": false,
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "scrollbar": {
      "horizontal_scroll": false
    },
    "bold_folder_labels": false,
    "indent_size": 20.0,
    "git_status": true,
    "file_icons": true,
    "entry_spacing": "standard",
    "hide_hidden": false,
    "dock": "left",
    "hide_gitignore": true
  },
  "tab_size": 2,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
}
